PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pocket_tarot
ADMIN_API_KEY=change-me
NEW_USERS_ACTIVE_BY_DEFAULT=true

# LLM API configuration (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_READING_TEMPERATURE=0.8
LLM_SUMMARY_TEMPERATURE=0.3
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# Firebase Admin configuration
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
